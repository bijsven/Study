{
    "manifest_version": 3,
    "name": "Studyuren Extension",
    "version": "1.0.0",
    "description": "Focus tracking voor Studyuren",
    "permissions": [
        "tabs",
        "activeTab",
        "windows",
        "idle"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}